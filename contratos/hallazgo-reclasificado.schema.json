{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HallazgoReclasificado",
  "description": "Se publica al reclasificar un hallazgo (HU-09), junto con hallazgo.registrado de la versión nueva.",
  "type": "object",
  "required": ["id_evento", "ocurrido_en", "hallazgo_id", "especie_anterior", "especie_nueva", "autor", "motivo"],
  "properties": {
    "id_evento": { "type": "string", "format": "uuid" },
    "ocurrido_en": { "type": "string", "format": "date-time" },
    "hallazgo_id": { "type": "integer" },
    "especie_anterior": { "type": "integer" },
    "especie_nueva": { "type": "integer" },
    "autor": { "type": "string" },
    "motivo": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
